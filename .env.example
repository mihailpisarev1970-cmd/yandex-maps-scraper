# ============================================================
#  Yandex Maps Scraper — пример конфигурации
#  1. Скопируйте этот файл в .env
#  2. Заполните значения своими
#  Файл .env в репозиторий НЕ попадает (см. .gitignore)
# ============================================================

# ---------- ЗАПРОСЫ ----------
# Один запрос (используется, если SEARCH_QUERIES не задан)
SEARCH_QUERY=Автосервис Санкт-Петербург

# Несколько запросов через точку с запятой
# SEARCH_QUERIES=Автосервис Санкт-Петербург;Шиномонтаж Санкт-Петербург;Автоэлектрик Санкт-Петербург

# Сколько организаций собирать на каждый запрос
MAX_RESULTS_PER_QUERY=200

# Общий лимит записей (0 — без ограничения)
MAX_RESULTS=0

# ---------- ФАЙЛЫ ----------
EXCEL_FILENAME=yandex_maps_results.xlsx
LOG_FILE=parser.log

# ---------- БРАУЗЕР ----------
# True — браузер не открывается (для серверов), False — видно окно
HEADLESS_MODE=True

# ---------- ПРОКСИ ----------
USE_PROXY=False
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# True — остановиться, если прокси не прошёл проверку
PROXY_CHECK_STRICT=True

# ---------- ПОВТОРЫ ----------
MAX_RETRIES=3
RETRY_DELAY=2.0

# ---------- СОХРАНЕНИЕ ----------
# Промежуточное сохранение Excel каждые N записей (0 — выключено)
SAVE_EVERY=25

# ---------- ПАУЗЫ (антибот) ----------
# Пачка: сколько карточек обработать до длинной паузы
BATCH_SIZE=25
BATCH_PAUSE_MIN=150
BATCH_PAUSE_MAX=300

# Пауза между запросами
QUERY_PAUSE_MIN=60
QUERY_PAUSE_MAX=180

# Пауза на карточку (мс)
CARD_PAUSE_MIN=1200
CARD_PAUSE_MAX=3000

# Пауза при появлении капчи (сек)
CAPTCHA_PAUSE=900
